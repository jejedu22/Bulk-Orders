{% extends 'base.html.twig' %}

{% block title %}Configuration{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
{% set icons = {
    'color': 'fas fa-palette', 'logo': 'far fa-image', 'welcome_text': 'fas fa-bullhorn', 'name': 'fas fa-signature',
    'contact_email': 'fas fa-at', 'favicon': 'far fa-star', 'text_confirm_email': 'fas fa-envelope-open-text', 'text_register_command': 'fas fa-receipt'
} %}
<div class="col-12">
    <div class="page-head">
        <div>
            <h1>Configuration</h1>
            <p class="subtitle">Personnalisation de l'application et des messages envoyés.</p>
        </div>
    </div>

    <div class="panel form-panel">
        <ul class="rows">
        {% for setting in settings %}
            <li>
                <a href="{{ path('settings_edit', {'id': setting.id}) }}" class="row-item">
                    <span class="avatar" style="background: #eef0f3; color: var(--text)"><i class="{{ icons[setting.name] ?? 'fas fa-cog' }}"></i></span>
                    <span class="row-main">
                        <span class="row-title d-block">{{ setting.name|trans }}</span>
                        <span class="row-meta d-block text-truncate">
                        {% if setting.name == 'color' %}
                            <span class="d-inline-block align-middle rounded-circle color-{{ setting.value }}" style="width: 14px; height: 14px"></span>
                            {{ ('settings.form.' ~ setting.value)|trans }}
                        {% elseif setting.name == 'logo' %}
                            <img src="{{ asset('uploads/logo/' ~ setting.value) }}" alt="logo" class="img-circle" style="max-height: 24px;">
                        {% else %}
                            {% set text = setting.value|striptags %}{{ text|length > 90 ? text|slice(0, 90) ~ '…' : text }}
                        {% endif %}
                        </span>
                    </span>
                </a>
            </li>
        {% else %}
            <li class="row-item text-muted">Aucun paramètre.</li>
        {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
