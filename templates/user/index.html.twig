{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
<div class="col-12" data-filter-scope>
    <div class="page-head">
        <div>
            <h1>Utilisateurs</h1>
            <p class="subtitle">{{ users|length }} compte{{ users|length > 1 ? 's' }}</p>
        </div>
        <div class="actions">
            <a href="{{ path('app_register') }}" class="btn btn-accent"><i class="fas fa-user-plus mr-1"></i> Nouvel utilisateur</a>
        </div>
    </div>

    <div class="toolbar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="search" data-filter-search placeholder="Nom, e-mail, téléphone…" aria-label="Rechercher un utilisateur">
        </div>
        <div class="chips">
            <button type="button" class="chip active" data-filter-value="">Tous</button>
            <button type="button" class="chip" data-filter-value="ROLE_ADMIN">{{ 'ROLE_ADMIN'|trans }}s</button>
        </div>
    </div>

    <div class="panel">
        <ul class="rows">
        {% for user in users|sort((a, b) => a.nom|lower <=> b.nom|lower) %}
            <li data-filter-item data-status="{{ user.roles|join(' ') }}" data-search="{{ user.prenom }} {{ user.nom }} {{ user.mail }} {{ user.phone }}">
                <a href="{{ path('user_show', {'id': user.id}) }}" class="row-item">
                    <span class="avatar">{{ user.prenom|initials(user.nom) }}</span>
                    <span class="row-main">
                        <span class="row-title d-block">{{ user.prenom }} {{ user.nom }}</span>
                        <span class="row-meta d-block text-truncate">
                            <span>{{ user.mail }}</span>
                            {% if user.phone %}<span class="hide-xs">{{ user.phone }}</span>{% endif %}
                        </span>
                    </span>
                    {% if 'ROLE_ADMIN' in user.roles %}<span class="pill pill-accent">{{ 'ROLE_ADMIN'|trans }}</span>{% endif %}
                </a>
            </li>
        {% endfor %}
        </ul>
        <div class="empty-state is-hidden" data-filter-empty><i class="fas fa-user-slash"></i><h3>Aucun utilisateur ne correspond</h3></div>
    </div>
</div>
{% endblock %}
