{% extends 'emails/layout.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}

{% block content %}
    {% set hours = (tokenLifetime / 3600)|round(0, 'ceil') %}
    <h1 style="font-size: 20px; margin: 0 0 16px">Réinitialisation de votre mot de passe</h1>
    <p style="margin: 0 0 12px">Bonjour{% if user is defined and user.prenom %} {{ user.prenom }}{% endif %},</p>
    <p style="margin: 0 0 12px">Vous avez demandé à réinitialiser votre mot de passe. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.</p>

    {{ include('emails/_button.html.twig', {url: url('app_reset_password', {token: resetToken.token}), label: 'Choisir un nouveau mot de passe'}) }}

    <p style="margin: 0 0 12px; font-size: 13px; color: #6c757d">
        Ce lien est valable {{ hours }} heure{{ hours > 1 ? 's' }}. Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>
        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="color: #6c757d; word-break: break-all">{{ url('app_reset_password', {token: resetToken.token}) }}</a>
    </p>
    <p style="margin: 0; font-size: 13px; color: #6c757d">Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail : votre mot de passe reste inchangé.</p>
{% endblock %}
