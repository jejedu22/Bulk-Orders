{% extends 'base.html.twig' %}

{% set page_title = suivi == 1 ? 'Suivi de livraison' : (suivi == 0 ? 'Toutes mes commandes' : 'Toutes les commandes') %}

{% block title %}{{ page_title }}{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
{% set today = "now"|date('Y-m-d') %}
<div class="col-12" data-filter-scope>
    <div class="page-head">
        <div>
            <h1>{{ page_title }}</h1>
            <p class="subtitle">{{ suivi == 0 ? 'Historique de vos commandes, de la plus récente à la plus ancienne.' : 'Par vente, de la plus récente à la plus ancienne.' }}</p>
        </div>
        {% if suivi == 0 %}
        <div class="actions">
            <a href="{{ path('passe_commande_index') }}" class="btn btn-accent"><i class="fas fa-shopping-basket mr-1"></i> Nouvelle commande</a>
        </div>
        {% endif %}
    </div>

    {% if jour_distribs is not empty %}
    <div class="toolbar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="search" data-filter-search placeholder="{{ suivi == 0 ? 'Rechercher un produit…' : 'Nom, n° de commande, produit…' }}" aria-label="Rechercher">
        </div>
        <div class="chips">
            <button type="button" class="chip active" data-filter-value="">Toutes</button>
            <button type="button" class="chip" data-filter-value="pending">À valider</button>
            <button type="button" class="chip" data-filter-value="validated">Validées</button>
            <button type="button" class="chip" data-filter-value="paid">Payées</button>
            <button type="button" class="chip" data-filter-value="delivered">Livrées</button>
        </div>
    </div>
    {% endif %}

{% for jour_distrib in jour_distribs %}
    {# 0 : mes commandes ; 1 : commandes restant à livrer ; 2 : toutes les commandes #}
    {% set commandes = (jour_distrib.commandes ?? [])|filter(c => (suivi == 0 and c.user == app.user) or (suivi == 1 and not c.livree) or suivi == 2) %}
    {% set nb_pending = commandes|filter(c => not c.confirmed)|length %}
    {% set nb_to_pay = commandes|filter(c => c.confirmed and not c.payee)|length %}
    {% set nb_paid = commandes|filter(c => c.confirmed and not c.livree)|length %}
    {% set nb_delivered = commandes|filter(c => c.livree)|length %}
    {% set collapsed = (suivi == 1 and jour_distrib.date|date('Y-m-d') != today) or (suivi == 2 and commandes is not empty and nb_delivered == commandes|length) %}
    <div class="panel {{ collapsed ? 'collapsed' }}" data-filter-group>
        <div class="panel-head panel-toggle">
            <div class="d-flex align-items-center" style="gap: .9rem; min-width: 0">
                {{ include('passe_commande/_date_badge.html.twig', {'date': jour_distrib.date}) }}
                <div style="min-width: 0">
                    <h3>Vente du {{ jour_distrib.date|format_date('long', locale='fr') }}</h3>
                    <div class="meta">
                        {% if jour_distrib.dateLivraison %}Livraison le {{ jour_distrib.dateLivraison|format_date('full', locale='fr') }} · {% endif %}
                        {{ commandes|length }} commande{{ commandes|length > 1 ? 's' }}
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center flex-wrap" style="gap: .4rem">
                {% if suivi != 0 %}
                    {% if nb_pending %}<span class="pill pill-danger" title="Chèque d'engagement non reçu">{{ nb_pending }} à valider</span>{% endif %}
                    {% if nb_to_pay %}<span class="pill pill-info" title="Validées, paiement définitif non reçu">{{ nb_to_pay }} à payer</span>{% endif %}
                    {% if nb_paid %}<span class="pill pill-warning" title="Validées, à livrer">{{ nb_paid }} à livrer</span>{% endif %}
                    {% if nb_delivered %}<span class="pill pill-success">{{ nb_delivered }} livrée{{ nb_delivered > 1 ? 's' }}</span>{% endif %}
                {% endif %}
                {% if suivi == 2 %}
                    <a href="{{ path('jour_distrib_distribution', {'id': jour_distrib.id}) }}" class="btn btn-sm btn-soft" title="Créneaux de retrait et bénévoles"><i class="fas fa-clock mr-1"></i> Distribution</a>
                    {% set nb_requests = demande_paiement_pending(jour_distrib) %}
                    {% if nb_requests %}
                        <form method="post" action="{{ path('jour_distrib_demande_paiement', {'id': jour_distrib.id}) }}" class="d-inline" data-confirm="Envoyer le montant définitif {{ helloasso_configured() ? 'et le lien de paiement en ligne ' }}à {{ nb_requests }} client{{ nb_requests > 1 ? 's' }} ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('demande-paiement' ~ jour_distrib.id) }}">
                            <button class="btn btn-sm btn-accent" title="E-mail aux clients dont les prix définitifs sont connus et qui ne l'ont pas encore reçu"><i class="fas fa-envelope mr-1"></i> Demander le paiement ({{ nb_requests }})</button>
                        </form>
                    {% endif %}
                    {% set nb_missing = demande_paiement_missing(jour_distrib) %}
                    {% if nb_missing %}<span class="pill pill-muted" title="Commandes non payées dont un produit n'a pas encore de prix final">{{ nb_missing }} sans prix définitif</span>{% endif %}
                    <a href="{{ path('export_xlsx', { id: jour_distrib.id }) }}" class="btn btn-sm btn-soft" title="Classeur Excel : commandes, par produit, détail, retraits"><i class="fas fa-file-excel mr-1"></i> Excel</a>
                {% endif %}
                <i class="fas fa-chevron-down ml-1"></i>
            </div>
        </div>

        <ul class="rows panel-collapsible">
        {% for commande in commandes %}
            {% set totalInit = 0 %}
            {% set totalFinal = 0 %}
            {% set hasFinal = true %}
            {% set search = commande.id ~ ' ' ~ commande.user.prenom ~ ' ' ~ commande.user.nom ~ ' ' ~ commande.commentaire %}
            {% for ligne in commande.ligneCommandes %}
                {% set totalInit = totalInit + ligne.quantite * ligne.product.prixInit %}
                {% set totalFinal = totalFinal + ligne.quantite * ligne.product.prixFinal %}
                {% if ligne.product.prixFinal is null %}{% set hasFinal = false %}{% endif %}
                {% set search = search ~ ' ' ~ ligne.product.nom %}
            {% endfor %}
            {% set status = commande.livree ? 'delivered' : (commande.payee ? 'paid' : (commande.confirmed ? 'validated' : 'pending')) %}
            {% set can_delete = not commande.livree and jour_distrib.date|date('Y-m-d') >= today and (suivi != 0 or not commande.confirmed) %}
            <li class="row-item align-items-start" data-filter-item data-status="{{ status }}" data-search="{{ search }}">
                {% if suivi != 0 %}
                    <span class="avatar hide-xs" title="{{ commande.user.prenom }} {{ commande.user.nom }}">{{ commande.user.prenom|initials(commande.user.nom) }}</span>
                {% endif %}
                <div class="row-main">
                    <div class="d-flex justify-content-between align-items-start flex-wrap" style="gap: .25rem .75rem">
                        <div>
                            <span class="row-title">{{ suivi != 0 ? commande.user.prenom ~ ' ' ~ commande.user.nom : 'Commande' }}</span>
                            <span class="text-muted small ml-1">n°{{ commande.id }}</span>
                            {% if suivi != 0 and commande.user.phone %}<a href="tel:{{ commande.user.phone }}" class="text-muted small ml-2"><i class="fas fa-phone-alt"></i> {{ commande.user.phone }}</a>{% endif %}
                        </div>
                        {{ include('commande/_status.html.twig') }}
                    </div>
                    <div class="mt-1">
                        {{ include('commande/_lines.html.twig', {'show_delivery': commande.confirmed and not commande.livree}) }}
                    </div>
                    {% if commande.commentaire %}
                        <div class="text-muted small mt-1"><i class="far fa-comment mr-1"></i>{{ commande.commentaire }}</div>
                    {% endif %}
                    <div class="d-flex justify-content-between align-items-center flex-wrap mt-2" style="gap: .5rem">
                        <div>
                            {% if hasFinal and totalFinal != totalInit %}
                                <span class="price-old">{{ totalInit|format_currency('EUR', locale='fr') }}</span>
                                <span class="price">{{ totalFinal|format_currency('EUR', locale='fr') }}</span>
                            {% else %}
                                <span class="price">{{ totalInit|format_currency('EUR', locale='fr') }}</span>
                            {% endif %}
                        </div>
                        <div class="d-flex align-items-center" style="gap: .75rem">
                            {% if suivi == 2 and not commande.confirmed %}
                                <a href="{{ path('livree_confirme', { commande: commande.id }) }}" class="btn btn-sm btn-accent" data-confirm="Valider la commande de {{ commande.user.prenom }} {{ commande.user.nom }} (chèque d'engagement reçu) ? Un e-mail de confirmation lui sera envoyé.">
                                    <i class="fas fa-check mr-1"></i> Valider
                                </a>
                            {% elseif suivi == 2 and not commande.payee %}
                                <a href="{{ path('commande_payee', { commande: commande.id }) }}" class="btn btn-sm btn-soft" data-confirm="Enregistrer le paiement définitif de {{ commande.user.prenom }} {{ commande.user.nom }} ?">
                                    <i class="fas fa-euro-sign mr-1"></i> Paiement reçu
                                </a>
                            {% elseif suivi == 1 and not commande.livree %}
                                <a href="{{ path('livree_commande', { commande: commande.id }) }}" class="btn btn-sm btn-accent" data-confirm="Confirmer la remise de la commande ?">
                                    <i class="fas fa-check mr-1"></i> Remise
                                </a>
                            {% endif %}
                            {% if commande.confirmed and not commande.livree and jour_distrib.creneaux is not empty %}
                                {% if suivi == 0 %}
                                    <a href="{{ path('commande_creneau', {'id': commande.id}) }}" class="btn btn-sm {{ commande.creneau ? 'btn-soft' : 'btn-accent' }}"><i class="fas fa-clock mr-1"></i> {{ commande.creneau ? 'Retrait ' ~ commande.creneau.libelle : 'Choisir mon créneau' }}</a>
                                {% else %}
                                    <span class="pill {{ commande.creneau ? 'pill-info' : 'pill-warning' }}"><i class="fas fa-clock"></i> {{ commande.creneau ? commande.creneau.libelle : 'Sans créneau' }}</span>
                                {% endif %}
                            {% endif %}
                            {% if suivi == 0 and helloasso_can_pay(commande) %}{{ include('commande/_paiement_form.html.twig', {'compact': true}) }}{% endif %}
                            {% if can_delete %}{{ include('commande/_delete_form.html.twig', {'compact': true}) }}{% endif %}
                        </div>
                    </div>
                </div>
            </li>
        {% else %}
            <li class="row-item text-muted" data-filter-item data-status="none" data-search="">Aucune commande pour cette vente.</li>
        {% endfor %}
        </ul>
    </div>
{% else %}
    <div class="panel">
        <div class="empty-state">
            <i class="fas fa-receipt"></i>
            <h3>Aucune commande</h3>
            {% if suivi == 0 %}
                <p>Vous n'avez pas encore passé de commande.</p>
                <a href="{{ path('passe_commande_index') }}" class="btn btn-accent">Passer commande</a>
            {% else %}
                <p>Personne n'a encore passé de commande.</p>
            {% endif %}
        </div>
    </div>
{% endfor %}

    <div class="panel is-hidden" data-filter-empty>
        <div class="empty-state"><i class="fas fa-search"></i><h3>Aucune commande ne correspond</h3></div>
    </div>
</div>
{% endblock %}
