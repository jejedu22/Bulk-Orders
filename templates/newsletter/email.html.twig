{% extends 'emails/layout.html.twig' %}

{% block title %}{{ newsletter.subject }}{% endblock %}

{% block content %}
    {{ content|raw }}
    {% if order_url %}
        {{ include('newsletter/_order_button.html.twig', {'url': order_url, 'color': brand.accent}) }}
    {% endif %}
{% endblock %}

{% block footer %}
    Vous recevez cet e-mail car vous êtes inscrit·e sur {{ brand.name }}.<br>
    <a href="{{ unsubscribe_url }}" style="color: #6c757d">Se désinscrire de la newsletter</a>
{% endblock %}
