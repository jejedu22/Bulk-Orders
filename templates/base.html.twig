{% set theme_colors = {
    'blue': '#007bff', 'cyan': '#17a2b8', 'gray': '#6c757d', 'gray-dark': '#343a40',
    'indigo': '#6610f2', 'yellow': '#e0a800', 'orange': '#fd7e14', 'pink': '#e83e8c',
    'red': '#dc3545', 'teal': '#20c997', 'green': '#28a745', 'purple': '#6f42c1'
} %}
{% set theme_color = options_settings.get('color') %}
{% set current_route = app.request.attributes.get('_route') %}
{% set current_params = app.request.attributes.get('_route_params') ?? {} %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %} · {{ options_settings.get('name') }}</title>

        <!-- Font Awesome Icons -->
        <link rel="stylesheet" href="{{ asset('/plugins/fontawesome/css/all.min.css') }}">
        <!-- Theme style (inclut Bootstrap 4) -->
        <link rel="stylesheet" href="{{ asset('/dist/css/adminlte.min.css') }}">
        <!-- Google Font: Source Sans Pro -->
        <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,600,700" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('/dist/css/style.css') }}">
        <link rel="stylesheet" href="{{ asset('/dist/css/app.css') }}">
        <style>:root { --accent: {{ theme_colors[theme_color] ?? theme_colors['green'] }}; }</style>
        <link rel="manifest" href="{{ path('pwa_manifest') }}">
        <meta name="theme-color" content="{{ theme_colors[theme_color] ?? theme_colors['green'] }}">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="{{ options_settings.get('name') }}">
        <link rel="apple-touch-icon" href="{{ options_settings.get('logo') ? path('pwa_icon', {size: 180, purpose: 'any'}) : asset('pwa/apple-touch-icon.png') }}">
        <link rel="shortcut icon" href="{{ asset('uploads/logo/' ~ options_settings.get('logo')) }}">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
        <div class="wrapper">

            <!-- Navbar -->
            <nav class="main-header navbar navbar-expand navbar-dark navbar-{{ theme_color }}">
                <!-- Left navbar links -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Menu"><i class="fas fa-bars"></i></a>
                    </li>

                    {% block navbar %}
                    {% endblock %}

                </ul>

                <!-- Right navbar links -->
                <ul class="navbar-nav ml-auto">
                {% if app.user %}
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                            <span class="avatar avatar-sm avatar-light">{{ app.user.prenom|initials(app.user.nom) }}</span>
                            <span class="d-none d-md-inline ml-1">{{ app.user.prenom }} {{ app.user.nom }}</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right user-dropdown">
                            <div class="px-3 py-2">
                                <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong>
                                <div class="text-muted small">{{ app.user.mail }}</div>
                                {% if app.user.phone %}<div class="text-muted small">{{ app.user.phone }}</div>{% endif %}
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="{{ path('app_logout') }}" class="dropdown-item"><i class="fas fa-sign-out-alt mr-2"></i>Déconnexion</a>
                        </div>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}" role="button" title="{{ 'menu.connexion'|trans }}">
                            <i class="fas fa-sign-in-alt"></i> <span class="d-none d-sm-inline">{{ 'menu.connexion'|trans }}</span>
                        </a>
                    </li>
                {% endif %}
                    <li class="nav-item">
                        {{ options_settings.getObfuscatedEmailLink(options_settings.get('contact_email')) | raw }}
                    </li>
                </ul>
            </nav>
            <!-- /.navbar -->

            <!-- Main Sidebar Container -->
            <aside class="main-sidebar elevation-4 sidebar-dark-{{ theme_color }}">
                <!-- Brand Logo -->
                <a href="{{ path('passe_commande_index') }}" class="brand-link navbar-{{ theme_color }}">
                    <img src="{{ asset('uploads/logo/' ~ options_settings.get('logo')) }}" alt="Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                    <span class="brand-text font-weight-light">{{ options_settings.get('name') }}</span>
                </a>

                <!-- Sidebar -->
                <div class="sidebar">
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">
                            {% if is_granted('ROLE_USER') %}
                            <li class="nav-header">MES COMMANDES</li>
                            <li class="nav-item">
                                <a href="{{ path('passe_commande_index') }}" class="nav-link {{ current_route in ['passe_commande_index', 'passe_commande_new'] ? 'active' }}">
                                    <i class="fas fa-shopping-basket nav-icon"></i>
                                    <p>{{ 'menu.order'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('commande_index') }}" class="nav-link {{ current_route == 'commande_index' ? 'active' }}">
                                    <i class="fas fa-bookmark nav-icon"></i>
                                    <p>{{ 'menu.my_last_command'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('synthese_index', {'suivi': 0 }) }}" class="nav-link {{ current_route == 'synthese_index' and (current_params.suivi ?? -1) == 0 ? 'active' }}">
                                    <i class="fas fa-history nav-icon"></i>
                                    <p>{{ 'menu.synthesis'|trans }}</p>
                                </a>
                            </li>
                            {% endif %}

                            {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-header">{{ 'menu.admin.title'|trans|upper }}</li>
                            <li class="nav-item">
                                <a href="{{ path('synthese_index', {'suivi': 2 }) }}" class="nav-link {{ current_route == 'synthese_index' and (current_params.suivi ?? -1) == 2 ? 'active' }}">
                                    <i class="fas fa-list-ul nav-icon"></i>
                                    <p>{{ 'menu.admin.all_command'|trans }}</p>
                                </a>
                            </li>
                            {% set delivery_open = current_route == 'livraison' %}
                            <li class="nav-item has-treeview {{ delivery_open ? 'menu-open' }}">
                                <a href="#" class="nav-link {{ delivery_open ? 'active' }}">
                                    <i class="fas fa-truck nav-icon"></i>
                                    <p>{{ 'menu.admin.delivery'|trans }}<i class="right fas fa-angle-left"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="{{ path('livraison', {'type': 'product'}) }}" class="nav-link {{ delivery_open and (current_params.type ?? '') == 'product' ? 'active' }}">
                                            <i class="fas fa-box nav-icon"></i>
                                            <p>{{ 'menu.admin.delivery_by_product'|trans }}</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="{{ path('livraison', {'type': 'command'}) }}" class="nav-link {{ delivery_open and (current_params.type ?? '') == 'command' ? 'active' }}">
                                            <i class="fas fa-file-invoice nav-icon"></i>
                                            <p>{{ 'menu.admin.delivery_by_command'|trans }}</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('recap') }}" class="nav-link {{ current_route == 'recap' ? 'active' }}">
                                    <i class="fas fa-layer-group nav-icon"></i>
                                    <p>{{ 'menu.admin.recap'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('jour_distrib_index') }}" class="nav-link {{ current_route starts with 'jour_distrib' ? 'active' }}">
                                    <i class="far fa-calendar-alt nav-icon"></i>
                                    <p>{{ 'menu.admin.add_day'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('product_index') }}" class="nav-link {{ current_route starts with 'product_' ? 'active' }}">
                                    <i class="fas fa-box-open nav-icon"></i>
                                    <p>{{ 'menu.admin.product'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('category_index') }}" class="nav-link {{ current_route starts with 'category_' ? 'active' }}">
                                    <i class="fas fa-tags nav-icon"></i>
                                    <p>{{ 'menu.admin.category'|trans }}</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('newsletter_index') }}" class="nav-link {{ current_route starts with 'newsletter_' and current_route != 'newsletter_unsubscribe' ? 'active' }}">
                                    <i class="fas fa-paper-plane nav-icon"></i>
                                    <p>{{ 'menu.admin.newsletter'|trans }}</p>
                                </a>
                            </li>
                            {% set settings_open = current_route starts with 'settings_' or current_route starts with 'user_' %}
                            <li class="nav-item has-treeview {{ settings_open ? 'menu-open' }}">
                                <a href="#" class="nav-link {{ settings_open ? 'active' }}">
                                    <i class="fas fa-cog nav-icon"></i>
                                    <p>{{ 'menu.admin.parameter.title'|trans }}<i class="right fas fa-angle-left"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="{{ path('settings_index') }}" class="nav-link {{ current_route starts with 'settings_' ? 'active' }}">
                                            <i class="fas fa-sliders-h nav-icon"></i>
                                            <p>{{ 'menu.admin.parameter.config'|trans }}</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="{{ path('user_index') }}" class="nav-link {{ current_route starts with 'user_' ? 'active' }}">
                                            <i class="fas fa-users nav-icon"></i>
                                            <p>{{ 'menu.admin.parameter.user'|trans }}</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            {% endif %}
                        </ul>
                    </nav>
                </div>
                <!-- /.sidebar -->
            </aside>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Content Header (Page header) -->
                <div class="content-header">
                    <div class="container-fluid">
                        {% block titre_page %}
                            <div class="welcome text-center">{{ options_settings.get('welcome_text')|raw }}</div>
                        {% endblock %}
                    </div>
                </div>
                <!-- /.content-header -->

                <!-- Main content -->
                <div class="content">
                    {% block modal %}
                    {% endblock %}
                    <div class="container-fluid">
                        {% set flash_icons = { 'success': 'fa-check-circle', 'warning': 'fa-exclamation-triangle', 'danger': 'fa-times-circle', 'info': 'fa-info-circle' } %}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }} alert-dismissible flash">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">×</button>
                                    <i class="fas {{ flash_icons[label] ?? 'fa-info-circle' }} mr-2"></i>
                                    {{ message|raw }}
                                </div>
                            {% endfor %}
                        {% endfor %}
                        <div class="row">
                            {% block body %}
                            {% endblock %}
                        </div>
                        <!-- /.row -->
                    </div><!-- /.container-fluid -->
                </div>
                <!-- /.content -->
            </div>
            <!-- /.content-wrapper -->
        </div>
        <!-- ./wrapper -->

        <!-- jQuery -->
        <script src="{{ asset('/plugins/jquery/jquery.min.js') }}"></script>
        <!-- Bootstrap 4 -->
        <script src="{{ asset('/plugins/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
        <!-- AdminLTE App -->
        <script src="{{ asset('/dist/js/adminlte.min.js') }}"></script>
        <script src="{{ asset('/dist/js/app.js') }}"></script>
        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js', { scope: '/' });
                });
            }
        </script>
        {% block javascripts %}
        {% endblock %}

    </body>
</html>
