{% extends 'base.html.twig' %}

{% block title %}Livraison par produit{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
<div class="col-12" data-filter-scope>
    <div class="page-head">
        <div>
            <h1>Livraison par produit</h1>
            <p class="subtitle">Produits restant à remettre pour les commandes payées.</p>
        </div>
        <div class="actions">
            <a href="{{ path('livraison', {'type': 'command'}) }}" class="btn btn-soft"><i class="fas fa-file-invoice mr-1"></i> Vue par commande</a>
        </div>
    </div>

    {% if jour_distribs|filter(j => j.products is not empty) is not empty %}
    <div class="toolbar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="search" data-filter-search placeholder="Produit ou personne…" aria-label="Rechercher">
        </div>
    </div>
    {% endif %}

{% for jour_distrib in jour_distribs|filter(j => j.products is not empty) %}
    <div class="panel" data-filter-group>
        <div class="panel-head panel-toggle">
            <div class="d-flex align-items-center" style="gap: .9rem">
                {{ include('passe_commande/_date_badge.html.twig', {'date': jour_distrib.dateLivraison ?: jour_distrib.date}) }}
                <div>
                    <h3>Vente du {{ jour_distrib.date|format_date('long', locale='fr') }}</h3>
                    <div class="meta">{{ jour_distrib.dateLivraison ? 'Livraison le ' ~ jour_distrib.dateLivraison|format_date('full', locale='fr') : 'Date de livraison non renseignée' }}</div>
                </div>
            </div>
            <i class="fas fa-chevron-down"></i>
        </div>
        <div class="panel-body panel-collapsible">
        {% for group in jour_distrib.products|group_by_category %}
            <section class="cat-section" data-filter-group>
                {{ include('category/_section_title.html.twig', {'category': group.category}) }}
                <div class="card-grid wide">
                {% for product in group.products %}
                    {% set lignes = jour_distrib.lignes[product.id] %}
                    {% set total = 0 %}
                    {% for l in lignes %}{% set total = total + l.quantite %}{% endfor %}
                    <div class="panel mb-0" data-filter-group>
                        <div class="panel-head">
                            <div>
                                <h3>{{ product.nom }}</h3>
                                <div class="meta">{{ product.conditionnement|format_number(locale='fr') }} {{ product.unit }}</div>
                            </div>
                            <span class="pill pill-accent" title="Quantité restant à remettre">{{ total }} à remettre</span>
                        </div>
                        <ul class="rows">
                        {% for ligneCommande in lignes %}
                            <li class="row-item" data-filter-item data-search="{{ product.nom }} {{ ligneCommande.commande.user.prenom }} {{ ligneCommande.commande.user.nom }} {{ ligneCommande.commande.id }}">
                                <span class="lines"><span class="qty">{{ ligneCommande.quantite }}×</span></span>
                                <span class="row-main">
                                    <span class="d-block">{{ ligneCommande.commande.user.prenom }} {{ ligneCommande.commande.user.nom }} <span class="text-muted small">n°{{ ligneCommande.commande.id }}</span></span>
                                    {% if ligneCommande.commande.commentaire %}<span class="row-meta d-block"><i class="far fa-comment mr-1"></i>{{ ligneCommande.commande.commentaire }}</span>{% endif %}
                                </span>
                                <a href="{{ path('livree_ligne_commande', { ligneCommande: ligneCommande.id }) }}" class="btn btn-sm btn-accent" data-confirm="Remettre {{ ligneCommande.quantite }} × {{ product.nom }} à {{ ligneCommande.commande.user.prenom }} {{ ligneCommande.commande.user.nom }} ?">
                                    <i class="fas fa-check mr-1"></i> Remis
                                </a>
                            </li>
                        {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
                </div>
            </section>
        {% endfor %}
        </div>
    </div>
{% else %}
    <div class="panel">
        <div class="empty-state">
            <i class="fas fa-truck"></i>
            <h3>Rien à livrer</h3>
            <p>Toutes les commandes payées ont été remises.</p>
        </div>
    </div>
{% endfor %}

    <div class="panel is-hidden" data-filter-empty>
        <div class="empty-state"><i class="fas fa-search"></i><h3>Aucun résultat</h3></div>
    </div>
</div>
{% endblock %}
