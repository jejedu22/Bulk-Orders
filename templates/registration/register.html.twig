{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="col-12">
<div class="panel mx-auto" style="max-width: 520px">
<div class="panel-body">
<h1 class="h4 text-center mb-3">Créer un compte</h1>

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.mail) }}
        {{ form_row(registrationForm.nom) }}
        {{ form_row(registrationForm.prenom) }}
        {{ form_row(registrationForm.phone) }}
        {{ form_row(registrationForm.password) }}
        {{ form_row(registrationForm.confirmPassword) }}
        {{ form_row(registrationForm.newsletter) }}
        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" class="btn btn-accent btn-block">Créer le compte</button>
    {{ form_end(registrationForm) }}
</div>
</div>
</div>
{% endblock %}
