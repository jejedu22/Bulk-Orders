# Copier vers .env.docker puis : docker compose --env-file .env.docker up -d --build
# (ne pas utiliser .env : ce fichier est lu par Symfony)

# Domaine servi par Traefik
APP_HOST=commandes.example.org

# openssl rand -hex 32
APP_SECRET=changeme

MYSQL_DATABASE=bulkorders
MYSQL_USER=bulkorders
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# Envoi des e-mails (null://null = aucun envoi). Voir « E-mails » dans le README.
# ex. gmail+smtp://adresse%40gmail.com:MOTDEPASSEAPPLICATION@default
MAILER_DSN=null://null
# Expéditeur (facultatif) : adresse du compte SMTP si le fournisseur refuse
# un autre expéditeur. Par défaut : l'e-mail de contact de la configuration.
MAILER_FROM=

# 1 = migrations Doctrine au démarrage
RUN_MIGRATIONS=1
