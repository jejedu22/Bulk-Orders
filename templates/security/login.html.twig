{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="col-12">
<div class="panel mx-auto" style="max-width: 420px">
<div class="panel-body">

    <h1 class="h4 text-center mb-3">Connectez-vous</h1>
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                Vous êtes connecté {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
        {% else %}
            <div class="input-group mb-3">
                <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" required autofocus placeholder="Saisissez votre email">
                <div class="input-group-append">
                    <div class="input-group-text">
                    <span class="fas fa-user"></span>
                    </div>
                </div>
            </div>
            <div class="input-group mb-3">
                <input type="password" name="password" id="inputPassword" class="form-control" required placeholder="Mot de passe">
                <div class="input-group-append">
                    <div class="input-group-text">
                    <span class="fas fa-lock"></span>
                    </div>
                </div>
            </div>

            <div class="row">
            <!-- /.col -->
            <div class="col-12">
                <button type="submit" class="btn btn-accent btn-block">Connexion</button>
            </div>
            <!-- /.col -->
            </div>
        {% endif %}

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

        #}

    </form>
</div>
    <div class="panel-foot d-flex justify-content-between">
        <a href="{{ path('app_register') }}">Créer un compte</a>
        <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
    </div>
</div>
</div>
{% endblock %}
