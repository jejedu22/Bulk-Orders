<form method="post" action="{{ path('commande_paiement', {'id': commande.id}) }}" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('paiement' ~ commande.id) }}">
    {% if compact ?? false %}
        <button class="btn btn-sm btn-accent" aria-label="Payer en ligne la commande n°{{ commande.id }}"><i class="fas fa-credit-card mr-1"></i> Payer en ligne</button>
    {% else %}
        <button class="btn btn-accent"><i class="fas fa-credit-card mr-1"></i> Payer en ligne</button>
    {% endif %}
</form>
