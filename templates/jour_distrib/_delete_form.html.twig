<form method="post" action="{{ path('jour_distrib_delete', {'id': jour_distrib.id}) }}" data-confirm="Voulez-vous vraiment supprimer cette vente ?">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jour_distrib.id) }}">
    <button class="btn btn-outline-danger"><i class="fas fa-trash-alt mr-1"></i> Supprimer</button>
</form>
