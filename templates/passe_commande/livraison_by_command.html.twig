{% extends 'base.html.twig' %}

{% block title %}Livraison par commande{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
{% set days = [] %}
{% for jour_distrib in jour_distribs %}
    {% set commandes = (jour_distrib.commandes ?? [])|filter(c => c.livree == false and c.confirmed == true) %}
    {% if commandes is not empty %}{% set days = days|merge([{'jour': jour_distrib, 'commandes': commandes}]) %}{% endif %}
{% endfor %}
<div class="col-12" data-filter-scope>
    <div class="page-head">
        <div>
            <h1>Livraison par commande</h1>
            <p class="subtitle">Commandes payées restant à remettre.</p>
        </div>
        <div class="actions">
            <a href="{{ path('livraison', {'type': 'product'}) }}" class="btn btn-soft"><i class="fas fa-box mr-1"></i> Vue par produit</a>
        </div>
    </div>

    {% if days is not empty %}
    <div class="toolbar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="search" data-filter-search placeholder="Nom, n° de commande, produit…" aria-label="Rechercher">
        </div>
    </div>
    {% endif %}

{% for day in days %}
    {% set jour_distrib = day.jour %}
    <div class="panel" data-filter-group>
        <div class="panel-head panel-toggle">
            <div class="d-flex align-items-center" style="gap: .9rem">
                {{ include('passe_commande/_date_badge.html.twig', {'date': jour_distrib.dateLivraison ?: jour_distrib.date}) }}
                <div>
                    <h3>Vente du {{ jour_distrib.date|format_date('long', locale='fr') }}</h3>
                    <div class="meta">{{ day.commandes|length }} commande{{ day.commandes|length > 1 ? 's' }} à remettre</div>
                </div>
            </div>
            <i class="fas fa-chevron-down"></i>
        </div>
        <div class="panel-body panel-collapsible">
            <div class="card-grid wide">
            {% for commande in day.commandes %}
                {% set totalFinal = 0 %}
                {% set search = commande.id ~ ' ' ~ commande.user.prenom ~ ' ' ~ commande.user.nom %}
                {% for ligne in commande.ligneCommandes %}
                    {% set totalFinal = totalFinal + ligne.quantite * (ligne.product.prixFinal ?? ligne.product.prixInit) %}
                    {% set search = search ~ ' ' ~ ligne.product.nom %}
                {% endfor %}
                <div class="tile status-warning" data-filter-item data-search="{{ search }}">
                    <div class="d-flex align-items-center" style="gap: .7rem">
                        <span class="avatar">{{ commande.user.prenom|initials(commande.user.nom) }}</span>
                        <div style="min-width: 0">
                            <div class="tile-title">{{ commande.user.prenom }} {{ commande.user.nom }}</div>
                            <div class="tile-sub">n°{{ commande.id }}{% if commande.user.phone %} · <a href="tel:{{ commande.user.phone }}" class="text-muted">{{ commande.user.phone }}</a>{% endif %}</div>
                        </div>
                    </div>
                    {{ include('commande/_lines.html.twig', {'show_delivery': true}) }}
                    {% if commande.commentaire %}<div class="tile-sub"><i class="far fa-comment mr-1"></i>{{ commande.commentaire }}</div>{% endif %}
                    <div class="tile-foot">
                        <span class="price">{{ totalFinal|format_currency('EUR', locale='fr') }}</span>
                        <a href="{{ path('livree_commande', { commande: commande.id }) }}" class="btn btn-sm btn-accent" data-confirm="Remettre toute la commande de {{ commande.user.prenom }} {{ commande.user.nom }} ?">
                            <i class="fas fa-check mr-1"></i> Tout remis
                        </a>
                    </div>
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
{% else %}
    <div class="panel">
        <div class="empty-state">
            <i class="fas fa-truck"></i>
            <h3>Rien à livrer</h3>
            <p>Toutes les commandes payées ont été remises.</p>
        </div>
    </div>
{% endfor %}

    <div class="panel is-hidden" data-filter-empty>
        <div class="empty-state"><i class="fas fa-search"></i><h3>Aucune commande ne correspond</h3></div>
    </div>
</div>
{% endblock %}
