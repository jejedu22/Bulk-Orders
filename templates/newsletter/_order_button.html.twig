{#
    Bouton « Commander » (e-mail et aperçu). Variables : url, color.
    Bouton à tableau et styles en ligne : seul rendu fiable dans les messageries.
#}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: 28px auto 8px">
    <tr>
        <td align="center" bgcolor="{{ color }}" style="border-radius: 6px; background: {{ color }}">
            <a href="{{ url }}" target="_blank" style="display: inline-block; padding: 13px 36px; font-family: Arial, Helvetica, sans-serif; font-size: 17px; font-weight: bold; line-height: 1.2; color: #ffffff; text-decoration: none; border-radius: 6px">Commander</a>
        </td>
    </tr>
</table>
