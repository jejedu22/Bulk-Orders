<form method="post" action="{{ path('user_delete', {'id': user.id}) }}" data-confirm="Voulez-vous vraiment supprimer {{ user.prenom }} {{ user.nom }} ?">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-outline-danger"><i class="fas fa-trash-alt mr-1"></i> Supprimer</button>
</form>
