<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ newsletter.subject }}</title>
</head>
<body style="margin: 0; padding: 0; background: #f4f6f9; font-family: Arial, Helvetica, sans-serif; color: #212529">
    <div style="max-width: 640px; margin: 0 auto; padding: 24px 16px">
        <div style="background: #ffffff; border-radius: 6px; padding: 24px; line-height: 1.5">
            {{ newsletter.content|raw }}
        </div>
        <p style="font-size: 12px; color: #6c757d; text-align: center; margin-top: 16px">
            Vous recevez cet e-mail car vous êtes inscrit·e sur {{ options_settings.get('name') }}.<br>
            <a href="{{ unsubscribe_url }}" style="color: #6c757d">Se désinscrire de la newsletter</a>
        </p>
    </div>
</body>
</html>
