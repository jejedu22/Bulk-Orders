{% if commande.livree %}
    <span class="pill pill-success"><i class="fas fa-check-double"></i> Livrée</span>
{% elseif commande.payee %}
    <span class="pill pill-info"><i class="fas fa-euro-sign"></i> Payée{{ commande.helloassoOrderId ? ' en ligne' }}</span>
{% elseif commande.confirmed %}
    <span class="pill pill-warning" title="Chèque d'engagement reçu, paiement définitif à venir"><i class="fas fa-check"></i> Validée</span>
{% else %}
    <span class="pill pill-danger"><i class="far fa-clock"></i> En attente de validation</span>
{% endif %}
