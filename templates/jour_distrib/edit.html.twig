{% extends 'base.html.twig' %}

{% block title %}Modifier la vente{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
<div class="col-12">
    <a href="{{ path('jour_distrib_index') }}" class="back-link"><i class="fas fa-arrow-left mr-1"></i> Jours de commande</a>
    <div class="page-head">
        <div>
            <h1>Vente du {{ jour_distrib.date|format_date('long', locale='fr') }}</h1>
            <p class="subtitle">{{ jour_distrib.commandes|length }} commande{{ jour_distrib.commandes|length > 1 ? 's' }}</p>
        </div>
        <div class="actions">{{ include('jour_distrib/_delete_form.html.twig') }}</div>
    </div>
    <div class="panel" style="max-width: 960px">
        <div class="panel-body">
            {{ include('jour_distrib/_form.html.twig', {'button_label': 'Enregistrer'}) }}
        </div>
    </div>
</div>
{% endblock %}
