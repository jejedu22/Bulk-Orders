{% extends 'base.html.twig' %}

{% block title %}{{ 'recap.title'|trans }}{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
{% set jours = joursRecap|filter(j => j.products is not empty) %}
<div class="col-12">
    <div class="page-head">
        <div>
            <h1>{{ 'recap.title'|trans }}</h1>
            <p class="subtitle">Quantités totales des commandes payées, par vente ouverte — à transmettre aux fournisseurs.</p>
        </div>
        {% if jours is not empty %}
        <div class="actions no-print">
            <button type="button" class="btn btn-soft" onclick="window.print()"><i class="fas fa-print mr-1"></i> Imprimer</button>
        </div>
        {% endif %}
    </div>

    {% for jourRecap in jours %}
        <div class="panel form-panel">
            <div class="panel-head panel-toggle">
                <div class="d-flex align-items-center" style="gap: .9rem">
                    {{ include('passe_commande/_date_badge.html.twig', {'date': jourRecap.jourDistrib}) }}
                    <div>
                        <h3>Vente du {{ jourRecap.jourDistrib|format_date('long', locale='fr') }}</h3>
                        <div class="meta">{{ jourRecap.products|length }} produit{{ jourRecap.products|length > 1 ? 's' }}</div>
                    </div>
                </div>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="panel-collapsible">
                {% set previous = false %}
                {% for product in jourRecap.products %}
                    {% if loop.first or product.categoryId != previous %}
                        {% if not loop.first %}</ul>{% endif %}
                        <div class="px-3 pt-3">
                            <h2 class="cat-title mb-1" style="font-size: .95rem">
                                <span class="cat-icon" style="width: 26px; height: 26px; font-size: .75rem"><i class="{{ product.categoryIcon ?: (product.categoryId ? 'fas fa-tag' : 'fas fa-question') }}"></i></span>
                                {{ product.categoryNom ?? 'category.none'|trans }}
                            </h2>
                        </div>
                        <ul class="rows">
                    {% endif %}
                    <li class="row-item">
                        <span class="lines"><span class="qty" style="font-size: 1.1rem">{{ product.total }}×</span></span>
                        <span class="row-main">
                            <span class="row-title d-block">{{ product.nom }}</span>
                            <span class="row-meta">{{ product.conditionnement|format_number(locale='fr') }} {{ product.unit }}</span>
                        </span>
                        <span class="num text-muted">{{ (product.total * product.conditionnement)|format_number(locale='fr') }} {{ product.unit }}</span>
                    </li>
                    {% set previous = product.categoryId %}
                    {% if loop.last %}</ul>{% endif %}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="panel">
            <div class="empty-state">
                <i class="fas fa-layer-group"></i>
                <h3>Rien à récapituler</h3>
                <p>Aucune commande payée sur une vente ouverte.</p>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
