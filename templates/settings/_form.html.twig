{{ form_start(form) }}
    {% if form.vars.data.id == 1 %}
        <p class="text-muted">Couleur principale de l'application (barre du haut, boutons, menus).</p>
        <div class="swatches" role="radiogroup" aria-label="{{ 'color'|trans }}">
        {% for choice in form.value %}
            <label class="swatch color-{{ choice.vars.value }} {{ choice.vars.checked ? 'active' }}" title="{{ choice.vars.label|trans }}">
                <input type="radio" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" {{ choice.vars.checked ? 'checked' }} aria-label="{{ choice.vars.label|trans }}">
            </label>
            {% do choice.setRendered %}
        {% endfor %}
        </div>
        {% do form.value.setRendered %}
    {% elseif form.vars.data.id == 2 %}
        <div class="d-flex align-items-center mb-3" style="gap: 1rem">
            <img src="{{ asset('uploads/logo/' ~ options_settings.get('logo')) }}" alt="Logo actuel" class="img-circle elevation-2 navbar-{{ options_settings.get('color') }}" style="max-height: 64px;">
            <span class="text-muted">Logo actuel</span>
        </div>
        {{ form_row(form.value, {'attr': {'placeholder': 'Choisir une image PNG'}}) }}
    {% else %}
        {{ form_row(form.value, {'label': setting.name|trans}) }}
    {% endif %}
    {{ form_rest(form) }}
    <div class="form-actions">
        <button class="btn btn-accent"><i class="fas fa-check mr-1"></i> {{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('settings_index') }}" class="btn btn-soft">Annuler</a>
    </div>
{{ form_end(form) }}

<script>
document.querySelectorAll('.swatch input').forEach(function (input) {
    input.addEventListener('change', function () {
        document.querySelectorAll('.swatch').forEach(function (s) { s.classList.toggle('active', s.contains(input)); });
    });
});
document.querySelectorAll('.custom-file-input').forEach(function (input) {
    input.addEventListener('change', function () {
        var label = input.parentNode.querySelector('.custom-file-label');
        if (label && input.files.length) { label.textContent = input.files[0].name; }
    });
});
</script>
