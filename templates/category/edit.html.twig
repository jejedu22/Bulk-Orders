{% extends 'base.html.twig' %}

{% block title %}Modifier {{ category.nom }}{% endblock %}

{% block titre_page %}{% endblock %}

{% block body %}
<div class="col-12">
    <a href="{{ path('category_index') }}" class="back-link"><i class="fas fa-arrow-left mr-1"></i> Catégories</a>
    <div class="page-head">
        <h1>{{ category.nom }}</h1>
        <div class="actions">{{ include('category/_delete_form.html.twig') }}</div>
    </div>
    <div class="panel form-panel">
        <div class="panel-body">
            {{ include('category/_form.html.twig') }}
        </div>
    </div>

    {% if category.products is not empty %}
    <div class="panel form-panel">
        <div class="panel-head"><h3>Produits de la catégorie</h3><span class="meta">{{ category.products|length }}</span></div>
        <ul class="rows">
        {% for product in category.products %}
            <li>
                <a href="{{ path('product_edit', {'id': product.id}) }}" class="row-item">
                    <span class="row-main">
                        <span class="row-title d-block">{{ product.nom }}</span>
                        <span class="row-meta">{{ product.conditionnement|format_number(locale='fr') }} {{ product.unit }}</span>
                    </span>
                    <span class="price">{{ product.prixInit|format_currency('EUR', locale='fr') }}</span>
                </a>
            </li>
        {% endfor %}
        </ul>
    </div>
    {% endif %}
</div>
{% endblock %}
